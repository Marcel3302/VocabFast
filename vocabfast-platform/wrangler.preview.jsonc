{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "vocabfast-language-preview",
  "main": "./src/preview-worker.js",
  "compatibility_date": "2026-09-04",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "PREVIEW_ACCOUNTS",
        "class_name": "PreviewAccountStore"
      }
    ]
  },
  "exports": {
    "PreviewAccountStore": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "observability": { "enabled": true }
}
