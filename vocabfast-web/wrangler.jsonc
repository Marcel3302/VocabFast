{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "vocabfast",
  "main": "./src/worker.js",
  "compatibility_date": "2026-09-02",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    { "binding": "DB" }
  ],
  "r2_buckets": [
    { "binding": "PDFS" }
  ],
  "observability": {
    "enabled": true
  }
}
