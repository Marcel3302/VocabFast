{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "vocabfast",
  "main": "./src/worker-v10.js",
  "compatibility_date": "2026-09-02",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "r2_buckets": [
    { "binding": "PDFS" }
  ],
  "observability": { "enabled": true },
  "ai": { "binding": "AI" },
  "vars": {
    "ADMIN_USERNAME": "admin",
    "ELITE_PRICE_LABEL": "7,99 € / Monat",
    "STRIPE_MODE": "live",

    "ELITE_CHECKOUT_URL": "https://buy.stripe.com/cNi28qfQ24OA4sybh3ao800",
    "ELITE_PRICE_ID": "price_1UBpKtCpS0yAsRaYApiQlUlW",
    "ELITE_PRODUCT_ID": "prod_VCDlxc8yoo0XGT",

    "ELITE_CHECKOUT_URL_LIVE": "https://buy.stripe.com/cNi28qfQ24OA4sybh3ao800",
    "ELITE_PRICE_ID_LIVE": "price_1UBpKtCpS0yAsRaYApiQlUlW",
    "ELITE_PRODUCT_ID_LIVE": "prod_VCDlxc8yoo0XGT",
    "STRIPE_PORTAL_URL_LIVE": "",

    "ELITE_CHECKOUT_URL_TEST": "https://buy.stripe.com/test_cNi28qfQ24OA4sybh3ao800",
    "ELITE_PRICE_ID_TEST": "price_1UBiyNCpS0yAsRaY22NMVFdS",
    "ELITE_PRODUCT_ID_TEST": "prod_VC7CT3eyDMrTWK",
    "STRIPE_PORTAL_URL_TEST": ""
  }
}
