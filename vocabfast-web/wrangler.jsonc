{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "vocabfast",
  "main": "./src/index.js",
  "compatibility_date": "2026-09-02",
  "ai": {
    "binding": "AI"
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true
  }
}
